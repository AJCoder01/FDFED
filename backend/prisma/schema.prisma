generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
  ARBITRATOR
}
enum VerificationStatus {
  draft
  submitted
  changes_requested
  approved
  rejected
  suspended
}
enum ListingStatus {
  draft
  published
  paused
  archived
}
enum BookingStatus {
  active
  in_progress
  completed
  cancelled
  reschedule_proposed
  disputed
}
enum DisputeStatus {
  pending_assignment
  assigned
  hearing_scheduled
  ruled
}
enum ApplicationStatus {
  pending
  approved
  rejected
}
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  name String
  phone String @default("")
  role Role
  isSuperUser Boolean @default(false)
  avatar String @default("")
  location String @default("")
  country String @default("")
  title String @default("")
  department String @default("")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  provider ProviderProfile?
  addresses CustomerAddress[]
  sessions UserSession[]
  bookings Booking[] @relation("CustomerBookings")
  cases Dispute[] @relation("AssignedCases")
  notifications Notification[]
  logs AuditLog[]
  files StoredFile[]
  requests CustomJobRequest[]
  @@index([role])
}
model UserSession {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId], references:[id])
  tokenHash String @unique
  demoOriginId String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model CustomerAddress {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  label String
  addressLine String
  city String
  pincode String
  isDefault Boolean @default(false)
  @@index([userId])
}
model ProviderProfile {
  id String @id
  user User @relation(fields:[id],references:[id])
  businessName String
  serviceArea String
  skills String[]
  documentName String @default("")
  verificationStatus VerificationStatus @default(draft)
  verificationFeedback String @default("")
  availability ProviderAvailability?
  services ServiceListing[]
  bookings Booking[] @relation("ProviderBookings")
}
model ProviderAvailability {
  providerId String @id
  provider ProviderProfile @relation(fields:[providerId],references:[id])
  days String[] @default(["Mon","Tue","Wed","Thu","Fri","Sat"])
  startTime String @default("09:00")
  endTime String @default("19:00")
  blackoutDates String[] @default([])
  leadMinutes Int @default(0)
  bufferMinutes Int @default(0)
  timeZone String @default("Asia/Kolkata")
}
model ServiceCategory {
  id String @id @default(uuid())
  name String @unique
  slug String @unique
  icon String
  description String
  services ServiceListing[]
}
model ServiceListing {
  id String @id @default(uuid())
  providerId String
  provider ProviderProfile @relation(fields:[providerId],references:[id])
  categoryId String
  category ServiceCategory @relation(fields:[categoryId],references:[id])
  title String
  description String
  priceMinor Int
  durationMinutes Int
  image String @default("")
  inclusions String[] @default([])
  exclusions String[] @default([])
  policy String @default("")
  availableSlots String[] @default([])
  status ListingStatus @default(draft)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings Booking[]
  @@index([providerId,status])
  @@index([categoryId,status,priceMinor])
}
model Booking {
  id String @id @default(uuid())
  customerId String
  customer User @relation("CustomerBookings",fields:[customerId],references:[id])
  providerId String
  provider ProviderProfile @relation("ProviderBookings",fields:[providerId],references:[id])
  serviceId String
  service ServiceListing @relation(fields:[serviceId],references:[id])
  serviceTitle String
  categoryName String
  providerName String
  providerPhone String
  customerName String
  customerPhone String
  address String
  durationMinutes Int
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  scheduledDate String
  scheduledSlot String
  status BookingStatus @default(active)
  statusBeforeDispute BookingStatus?
  acceptedAt DateTime?
  notes String @default("")
  completionNotes String @default("")
  requestKey String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  timeline BookingTimelineEvent[]
  proposals BookingTimeProposal[]
  review Review?
  payment PaymentRecord?
  tickets SupportTicket[]
  disputes Dispute[]
  @@index([customerId,createdAt])
  @@index([providerId,scheduledDate,status])
}
model BookingTimelineEvent {
  id String @id @default(uuid())
  bookingId String
  booking Booking @relation(fields:[bookingId],references:[id])
  title String
  desc String
  time DateTime @default(now())
}
model BookingTimeProposal {
  id String @id @default(uuid())
  bookingId String
  booking Booking @relation(fields:[bookingId],references:[id])
  date String
  slot String
  status String @default("pending")
  createdAt DateTime @default(now())
}
model Review {
  bookingId String @id
  booking Booking @relation(fields:[bookingId],references:[id])
  rating Int
  comment String
  reply String?
  createdAt DateTime @default(now())
}
model PaymentRecord {
  id String @id @default(uuid())
  bookingId String @unique
  booking Booking @relation(fields:[bookingId],references:[id])
  amountMinor Int
  refundedMinor Int @default(0)
  feeMinor Int
  payoutMinor Int
  method String
  status String
  simulated Boolean @default(true)
  createdAt DateTime @default(now())
  refunds RefundRecord[]
}
model RefundRecord {
  id String @id @default(uuid())
  paymentId String
  payment PaymentRecord @relation(fields:[paymentId],references:[id])
  amountMinor Int
  reasonKey String @unique
  createdAt DateTime @default(now())
}
model SupportTicket {
  id String @id @default(uuid())
  bookingId String
  booking Booking @relation(fields:[bookingId],references:[id])
  issueType String
  severity String
  description String
  status String @default("open")
  resolutionOutcome String?
  createdAt DateTime @default(now())
  @@index([bookingId,status])
}
model Dispute {
  id String @id @default(uuid())
  bookingId String
  booking Booking @relation(fields:[bookingId],references:[id])
  arbitratorId String?
  arbitrator User? @relation("AssignedCases",fields:[arbitratorId],references:[id])
  claimMinor Int
  customerStatement String
  providerStatement String @default("")
  status DisputeStatus @default(pending_assignment)
  createdAt DateTime @default(now())
  evidences DisputeEvidence[]
  hearing Hearing?
  ruling Ruling?
  @@index([arbitratorId,status])
  @@index([bookingId,status])
}
model DisputeEvidence {
  id String @id @default(uuid())
  disputeId String
  dispute Dispute @relation(fields:[disputeId],references:[id])
  fileId String @unique
  file StoredFile @relation(fields:[fileId],references:[id])
  title String
}
model Hearing {
  disputeId String @id
  dispute Dispute @relation(fields:[disputeId],references:[id])
  scheduledDate String
  scheduledTime String
  startsAt DateTime @db.Timestamptz(3)
  meetUrl String
  status String @default("scheduled")
}
model Ruling {
  disputeId String @id
  dispute Dispute @relation(fields:[disputeId],references:[id])
  verdict String
  awardMinor Int
  reason String
  issuedAt DateTime @default(now())
}
model ArbitratorApplication {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  name String
  phone String
  country String
  linkedin String @default("")
  title String
  experience Int
  expertise String
  organization String
  prevExperience String @default("")
  files Json
  status ApplicationStatus @default(pending)
  rejectReason String?
  decidedAt DateTime?
  submittedAt DateTime @default(now())
  documents StoredFile[]
}
model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  title String
  message String
  targetLink String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId,read,createdAt])
}
model AuditLog {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  type String
  description String
  timestamp DateTime @default(now())
  @@index([userId,timestamp])
}
model StoredFile {
  id String @id @default(uuid())
  ownerId String?
  owner User? @relation(fields:[ownerId],references:[id])
  applicationId String?
  application ArbitratorApplication? @relation(fields:[applicationId],references:[id])
  filename String
  path String @unique
  mime String
  size Int
  public Boolean @default(false)
  createdAt DateTime @default(now())
  evidence DisputeEvidence?
}
model CustomJobRequest {
  id String @id @default(uuid())
  customerId String
  customer User @relation(fields:[customerId],references:[id])
  category String
  title String
  location String
  description String
  preferredDate String
  budgetMinor Int?
  contactName String
  contactPhone String
  createdAt DateTime @default(now())
  @@index([customerId,createdAt])
}
